APP_NAME=Elifba
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://elifba.test

APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=az_AZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Who runs this instance, shown on /privacy (docs/architecture.md §7).
ELIFBA_OPERATOR_NAME=
ELIFBA_OPERATOR_EMAIL=

# Reverb, the WebSocket server for the phone remote (docs/architecture.md §4,
# §10). `composer setup` runs `reverb:install`, which appends a random
# REVERB_APP_ID, REVERB_APP_KEY and REVERB_APP_SECRET to .env. The browser
# reaches Reverb on VITE_REVERB_*; the app talks to it on REVERB_*. Origins
# allowed: the host of APP_URL (REVERB_ALLOWED_ORIGINS overrides it).
# `composer dev:lan` swaps the hosts for the laptop's LAN IP.
#
# HTTPS with Herd (needed for the share card's Web Share, §6, §10): run
# `herd secure elifba`, then set
#   APP_URL=https://elifba.test
#   REVERB_HOST="elifba.test"
#   REVERB_SCHEME=https
#   REVERB_CA_BUNDLE="$HOME/Library/Application Support/Herd/config/valet/CA/LaravelValetCASelfSigned.pem"
# (write $HOME out). Reverb then serves wss with Herd's certificate for its
# hostname, Vite serves https with it, and the app trusts Herd's CA when it
# broadcasts. If port 8080 is taken, set REVERB_SERVER_PORT and REVERB_PORT
# to a free one.
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"
