# Elifba with Docker (docker-compose.yml, docs/architecture.md §10).
#
# Copy this file to `.env` in the repository's root and fill it, or let
#   scripts/docker-env.sh <domain> [https|http] [port]
# copy it and fill the domain and the secrets. Then
#   docker compose up -d --build --wait
#
# docker-compose.yml reads this file for its own ${...} values and passes it
# to the PHP containers as their environment. It sets what follows from the
# services itself (APP_URL, the database host, Reverb's internal address,
# LOG_CHANNEL=stderr, QUEUE_CONNECTION=sync), so those are not here.

# --- The address -------------------------------------------------------------

# The one host name people open. Caddy serves it, APP_URL is built from it,
# Reverb accepts sockets only from pages on it, and the browser's socket
# connects to it.
ELIFBA_DOMAIN=elifba.example.az

# https: a real domain whose DNS points at this machine, with ports 80 and 443
#   open; Caddy gets and renews a Let's Encrypt certificate by itself.
# http: a try-out without certificates, on this machine (ELIFBA_DOMAIN=
#   localhost) or on the school network (the machine's LAN address, e.g.
#   192.168.1.20, so phones on the same Wi-Fi can open /pult). Browsers allow
#   the share card's Web Share only on https.
ELIFBA_SCHEME=https

# The port in the address: 443 with https; with http any free port (8088).
ELIFBA_PORT=443

# The host port for Caddy's port 80 (http→https redirects, certificate
# checks). An http try-out does not use it, so any free port will do there
# (scripts/docker-env.sh picks ELIFBA_PORT + 1).
ELIFBA_REDIRECT_PORT=80

# The browser's socket settings are built into the assets: after changing
# ELIFBA_* or REVERB_APP_KEY, run `docker compose up -d --build`.

# --- Secrets (scripts/docker-env.sh fills them) --------------------------------

# base64: and 32 random bytes: echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# openssl rand -hex 4, -hex 10 and -hex 20
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# The `elifba` PostgreSQL user's password: openssl rand -hex 20
DB_PASSWORD=

# --- The instance ------------------------------------------------------------

APP_NAME=Elifba
APP_LOCALE=az
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=az_AZ
# The log goes to `docker compose logs`. MAIL_MAILER=log below writes mails
# at `debug`; once mail goes out over smtp, `warning` keeps the log quieter.
LOG_LEVEL=debug

# Who runs this instance, shown on /privacy (docs/architecture.md §7).
ELIFBA_OPERATOR_NAME=
ELIFBA_OPERATOR_EMAIL=

# Google sign-in for teachers (docs/decisions/008-google-sign-in.md): the OAuth
# client of a "Web application" in Google Cloud Console, with the redirect URI
# https://<the address teachers open>/auth/google/callback. Empty = off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Nightly database dump (the `backup` service): Baku time, days kept.
BACKUP_AT=03:00
BACKUP_KEEP_DAYS=14

# --- Mail --------------------------------------------------------------------

# Teachers confirm their address and reset passwords by mail. `log` writes
# the mails to `docker compose logs app` (enough for a try-out); set `smtp`
# and the lines below before teachers sign up.
MAIL_MAILER=log
MAIL_SCHEME=smtp
MAIL_HOST=smtp.example.az
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=elifba@example.az
MAIL_FROM_NAME=Elifba
